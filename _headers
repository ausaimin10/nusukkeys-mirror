# The shell files (page, code, style, worker) must never be served
# stale: the worker itself is the cache, and a cached sw.js would keep
# an old worker (and its old cached files) alive after a deploy. no-cache
# makes the browser revalidate them on every load.
/sw.js
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/codes.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
/codes-head.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
